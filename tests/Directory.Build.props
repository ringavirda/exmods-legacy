<Project>
  <!--
    Test projects reuse the same per-target-framework game install resolution as the mods under
    src/, so legacy test runs (-p:Legacy=true) compile against the matching 1.21 (net8.0) / 1.20
    (net7.0) API and fall back to 1.22 (net10.0) otherwise. Importing the src props gives the test
    csprojs $(GamePath)/$(GameVersion) per TFM plus the missing-install guard and the legacy CS8625
    suppression. The runtime VsAssemblyResolver picks the matching install (env-var override, else
    the nearest .game/<slug> from the test output upward, which holds the build's install whether it
    sits in the repository or at the workspace root) so the headless run loads the right version's
    assemblies.
  -->
  <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.props" />

  <PropertyGroup>
    <!-- Run the test assemblies in parallel across all cores. Applied automatically by
         `dotnet test` / the IDE runner. The scripts/run-tests.* helper runs the per-version suites
         concurrently on top of this.

         Within an assembly, xunit.runner.json turns collection parallelism OFF. The mods read their
         config live from a process-global register (SmexValues/PpexValues), and several tests retune
         it mid-run - so a class exercising production code could observe another class's temporary
         values. That produced a 1.20 smex failure that appeared only under parallel load and passed
         on every standalone re-run. Assembly-level parallelism is where the wall-clock actually
         comes from anyway: a whole suite is a few hundred milliseconds. -->

    <RunSettingsFilePath>$(MSBuildThisFileDirectory)parallel.runsettings</RunSettingsFilePath>

    <!-- A test process applies Harmony patches after earlier tests ran the patched game methods'
         callers hot. With tiered PGO a caller re-jitted at tier 1 inlines a virtual target behind
         a guard on its most frequent receiver type, and a later patch never runs for that type:
         Block.GetDrops inside SpawnDropsAndRemoveBlock (LatePatchTests). -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Content
      Include="$(MSBuildThisFileDirectory)xunit.runner.json"
      Link="xunit.runner.json"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="$(MSBuildThisFileDirectory)LegacyReleasedHistory.cs"
      Link="LegacyReleasedHistory.cs"
    />
  </ItemGroup>
</Project>
